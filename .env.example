# Copia este fichero a `.env.local` y rellena los valores de tu propio
# despliegue de Convex. `.env.local` esta ignorado por git.

# Despliegue que usa `npx convex dev`. Lo genera Convex al vincular el proyecto.
CONVEX_DEPLOYMENT=dev:tu-despliegue

# URL del cliente Convex que consume la app (src/lib/convex-client.ts).
VITE_CONVEX_URL=https://tu-despliegue.convex.cloud

# URL de las HTTP actions del mismo despliegue.
VITE_CONVEX_SITE_URL=https://tu-despliegue.convex.site
